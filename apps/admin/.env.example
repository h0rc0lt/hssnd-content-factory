# HSSND Content Factory — Supabase server credentials.
# Copy this file to .env.local for local dev, and set the same two values
# in Vercel Project Settings > Environment Variables for production.
#
# Both are read ONLY in lib/supabase/server.ts, which is marked
# server-only — never imported by client code, never exposed to the
# browser. Neither variable is prefixed NEXT_PUBLIC_ on purpose.

# Not a secret — every Supabase project's REST URL follows this exact
# pattern (https://{project_ref}.supabase.co). Filled in for convenience;
# the tool call to fetch this programmatically failed in this session, so
# this is derived from the standard convention rather than fetched live —
# double check it matches your project's Settings > API page.
SUPABASE_URL=https://ybflevlwyrwcbbsgeera.supabase.co

# This IS a secret — bypasses Row Level Security entirely. Get it from
# Supabase Dashboard > Project Settings > API > service_role key.
# Never committed, never pasted into chat, never seen by Claude.
SUPABASE_SERVICE_ROLE_KEY=

# NOT a secret — designed to be public, safe in browser bundles. Used by
# lib/supabase/browser.ts for direct browser -> Supabase Storage uploads
# (bypassing Vercel's 4.5 MB Function body limit). Same URL as SUPABASE_URL
# above; NEXT_PUBLIC_ vars can't be shared with server-only vars in Next.js,
# so it's duplicated here.
NEXT_PUBLIC_SUPABASE_URL=https://ybflevlwyrwcbbsgeera.supabase.co

# NOT a secret — the publishable key, safe in browser bundles. Get it from
# Supabase Dashboard > Project Settings > API > Publishable key (or the
# legacy "anon" key — either works for the signed-upload flow this powers,
# since that flow needs no RLS grant at all).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This IS a secret — used server-only in app/api/lora/train/route.ts to
# submit LoRA training jobs to fal.ai. Get it from fal.ai Dashboard >
# Keys. Never committed, never pasted into chat, never seen by Claude.
FAL_KEY=

# This IS a secret — used server-only in app/api/generate/route.ts (the
# "nano-banana" provider only — the other two providers use FAL_KEY
# instead) to call the Google Gemini API directly, not through fal.ai. Get
# a free key from Google AI Studio (aistudio.google.com/apikey) — the
# free tier is 500 requests/day against gemini-2.5-flash-image, which is
# the whole reason this provider exists (see /api/generate's doc comment).
# Never committed, never pasted into chat, never seen by Claude.
GEMINI_API_KEY=

# This IS a secret — checked as `Authorization: Bearer <value>` by
# app/api/cron/poll-training/route.ts. Originally set up for Vercel Cron;
# now called instead by .github/workflows/poll-training.yml on a schedule,
# since Vercel Cron silently doesn't run schedules more frequent than once
# a day on this team's Hobby plan (confirmed via runtime logs — the
# built-in cron never fired). Generate any random string yourself (e.g.
# `openssl rand -hex 32`) and set the same value here, in Vercel Project
# Settings, AND as a GitHub Actions repo secret named CRON_SECRET (Settings
# > Secrets and variables > Actions). Never committed, never pasted into
# chat, never seen by Claude.
CRON_SECRET=

# These ARE secrets — HTTP Basic Auth credentials checked by middleware.ts,
# which gates every page and API route except /api/cron/* (that one has its
# own CRON_SECRET check instead — Vercel Cron doesn't send Basic Auth).
# This repo is public and its routes are guessable, and /api/lora/train
# submits a real, billed fal.ai job per call, so this must be set before
# deploying. Pick any username/password yourself and set the same values
# here and in Vercel Project Settings. Never committed, never pasted into
# chat, never seen by Claude.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
